ANTHROPIC_API_KEY=
# Fast default for the overlay; switch to claude-sonnet-5-5 if extraction quality is poor.
ANTHROPIC_MODEL=claude-haiku-5-5
# Shared bearer token (also baked into the app as EXPO_PUBLIC_AGENT_TOKEN). The server refuses to start with change-me in production.
AGENT_TOKEN=change-me
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
PORT=8787
