ANTHROPIC_API_KEY=
# Fast default for the overlay; switch to claude-sonnet-5-5 if extraction quality is poor.
ANTHROPIC_MODEL=claude-haiku-5-5
# Privy app id. Access tokens are verified against
# https://auth.privy.io/api/v1/apps/<PRIVY_APP_ID>/jwks.json
# (iss privy.io, aud this app id, ES256). Required unless AUTH_MODE=token.
PRIVY_APP_ID=
# AUTH_MODE=privy
# Dev escape hatch only. Set AUTH_MODE=token and a long random AGENT_TOKEN.
# The app no longer sends this token. Do not put it in EXPO_PUBLIC_*.
# AUTH_MODE=token
# AGENT_TOKEN=change-me
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Monad mainnet RPC (real MON). Read-only.
MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz
# Ethereum mainnet RPC for ENS lookups (names live on L1, payments stay on Monad).
ENS_RPC_URL=https://ethereum-rpc.publicnode.com
PORT=8787
# Where connected agents and their requests are kept (hashes only). Never commit it.
# AGENTS_FILE=data/agents.json
