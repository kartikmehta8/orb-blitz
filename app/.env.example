# Privy dashboard → Settings → Clients (mobile). Client IDs start with "client-".
# Add "com.bubbleagent.app" to the client's allowed app identifiers and "bubbleagent" to its URL schemes.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=
# Agent server URL (your ngrok domain or a deployed host). No trailing slash.
EXPO_PUBLIC_AGENT_URL=https://your-domain.ngrok-free.dev
# Must equal AGENT_TOKEN in server/.env. Bundled into the APK, so treat it as demo-grade auth.
EXPO_PUBLIC_AGENT_TOKEN=change-me
# Optional overrides.
EXPO_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
EXPO_PUBLIC_EXPLORER_URL=https://testnet.monadvision.com
