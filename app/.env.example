# Privy dashboard → App settings. Add "com.bubbleagent.app" as an allowed Android app identifier.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=
# Agent server (cloudflared tunnel URL or deployed host). No trailing slash.
EXPO_PUBLIC_AGENT_URL=https://your-tunnel.trycloudflare.com
# Must equal AGENT_TOKEN on the server. Bundled into the APK: demo-grade only.
EXPO_PUBLIC_AGENT_TOKEN=change-me
# Optional overrides.
EXPO_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
EXPO_PUBLIC_EXPLORER_URL=https://testnet.monadvision.com
