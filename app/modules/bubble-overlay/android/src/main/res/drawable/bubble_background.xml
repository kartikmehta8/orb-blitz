<?xml version="1.0" encoding="utf-8"?>
<!--
  Orb disc: flat Monad purple (#6E54FF, no gradient) with a 1dp white ring
  at 20% opacity to separate it from busy backgrounds. The first layer's oval
  also gives the view its elevation-shadow outline.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="oval">
      <solid android:color="#FF6E54FF" />
    </shape>
  </item>
  <item>
    <shape android:shape="oval">
      <solid android:color="#00000000" />
      <stroke android:width="1dp" android:color="#33FFFFFF" />
    </shape>
  </item>
</layer-list>
